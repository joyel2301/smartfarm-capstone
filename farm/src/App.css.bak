.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh; /* ?꾩껜 ?믪씠瑜??붾㈃ ?믪씠濡??ㅼ젙 */
}
 
.header {
  height: 60px;
  background-color: gray;
  display: flex;
  align-items: center;
  justify-content: center;
}
 
.main {
  max-width: 1920px; /* 理쒕? ?덈퉬瑜?怨좎젙 */
  width: 100%; /* 湲곕낯?곸쑝濡??붾㈃ ?덈퉬瑜??곕쫫 */
  margin: 0 auto; /* ?붿냼 異⑸룎?놁씠 源붾걫?섍쾶 ?⑥뼱吏? ?꾩닔 x */
  display: flex;
  flex: 1; /* ?⑥? 怨듦컙??梨꾩슦??湲곕뒫 */
  background-color: beige;
  align-items: center;
  justify-content: center;
}
 

